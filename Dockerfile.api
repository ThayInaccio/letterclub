# Só a API. Existe porque o Railway não escolhe um alvo (--target) dentro do Dockerfile;
# mantenha igual ao estágio "api" do Dockerfile principal.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY server ./server
USER node
EXPOSE 3000
HEALTHCHECK CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1
CMD ["node", "server/index.js"]
